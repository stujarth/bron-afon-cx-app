{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "DAMP_REPORTS_MOCK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    }
  }
}
